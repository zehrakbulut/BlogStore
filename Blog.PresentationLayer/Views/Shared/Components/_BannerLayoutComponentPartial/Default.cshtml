@using Blog.EntityLayer.Entities
@model List<Recipe>

<div class="w3l-banner py-5">
    <div class="container py-lg-3 py-md-3">
        <div class="row py-lg-3">
            @foreach (var item in Model)
            {
                <div class="col-lg-4 col-md-6 col-sm-12 mt-4 d-flex align-items-stretch">
                    <div class="maghny-grid">
                        <figure class="effect-lily border-radius">
                            <img class="img-fluid radius-image" src="@item.Image" alt="" />
                            <figcaption>
                                <div>
                                    <h4 class="top-text1">@item.Title</h4>
                                    <aside class="p-meta-info">
                                        <span class="meta-info-el meta-info-custom">
                                            <span class="fa fa-bell-o mr-2"></span>Sponsered by
                                            <strong>@item.ChefName</strong>
                                        </span>
                                    </aside>
                                </div>
                            </figcaption>
                        </figure>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
