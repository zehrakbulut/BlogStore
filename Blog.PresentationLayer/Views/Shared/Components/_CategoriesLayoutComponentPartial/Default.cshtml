@using Blog.EntityLayer.Entities
@model List<Category>

<div class="col-lg-8 mt-lg-0 mt-md-5 mt-sm-4 mt-2">
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-lg-4 col-md-4 col-sm-6 mt-md-0 mt-4">
                <div class="column">
                <a href="#single"><img src="@item.Image" alt="" class="img-fluid" /></a>
                <div class="info">
                    <h4><a href="#single">@item.Name</a></h4>
                </div>
            </div>
        </div>
        }
    </div>
</div>