@using Blog.EntityLayer.Entities
@model List<Recipe>

<div class="row">
    <!-- Latest Recipes -->
    <div class="col-lg-8 most-recent pr-lg-4">
        <h3 class="title-left mb-3">Latest Recipes</h3>
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 col-md-6 item">
                    <div class="card">
                        <div class="card-header p-0 position-relative">
                            <a href="#blog-single">
                                <img class="card-img-bottom d-block radius-image" src="@item.Image"
                                     alt="Card image cap">
                            </a>
                            <div class="post-pos">
                                <a href="#reciepe" class="receipe green">Reciepe</a>
                                <span class="meta-info meta-info-custom">
                                    <span class="fa fa-clock-o mr-2"></span>@item.Time.ToString(@"hh\:mm")
                                </span>
                            </div>
                        </div>
                        <div class="card-body p-0 blog-details">
                            <a href="#blog-single" class="blog-desc">
                                @item.Title
                            </a>
                            <p>@item.Description</p>
                            <div class="p-footer mt-3">
                                <div class="p-meta-info">
                                    <a href="#img" class="post-img-anchor">
                                        <img src="~/Blog/assets/images/a1.jpg" alt=""
                                             class="post-img radius-img img-fluid" />
                                    </a>
                                    <a href="#url">@item.ChefName</a>
                                </div>
                                <a href="#read" class="read">Read more <span class="fas fa-arrow-right"></span></a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <!-- Tweets Layout -->
    <div class="col-lg-4">
        @await Component.InvokeAsync("_TweetsLayoutComponentPartial")
    </div>
</div>
