
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/BlogLayout/Index.cshtml";
}

<!-- contact breadcrumb -->
<div class="w3l-contact-breadcrumb w3l-search-results py-5 text-center">
    <div class="container py-lg-4 py-md-3">
        <ul class="breadcrumbs-custom-path mb-sm-3 mb-2 text-center">
            <li><a href="index.html">Anasayfa</a></li>
            <li class="active"><span class="fa fa-arrow-right mx-2" aria-hidden="true"></span> İletişim Sayfası </li>
        </ul>
        <h3 class="title-big mb-4">Bize Ulaş</h3>
        <p>
            Size harika bir deneyim sunmak istiyoruz, bu yüzden sizden haber almak istiyoruz. Geri bildirimleriniz bize
            sevdiğiniz etkinlikleri ve beklediğiniz hizmeti daha fazla sunmamızda yardımcı oluyor.
        </p>
    </div>
</div>
<!-- contact breadcrumb -->
<!-- contacts -->
<section class="w3l-contact-7 pt-5" id="contact">
    <div class="contacts-9 pt-lg-5 pt-md-4">
        <div class="container">
            <div class="top-map">
                <div class="row map-content-9">
                    <div class="col-lg-8">
                        <p class="mb-4">E-posta adresiniz yayınlanmayacak. Gerekli alanlar işaretlenmiştir *</p>
                        <form action="https://sendmail.w3layouts.com/submitForm" method="post" class="">
                            <div class="form-grid">
                                <div class="input-field">
                                    <label> Adınız</label>
                                    <input type="text" name="w3lName" id="w3lName" placeholder="" required="">
                                </div>
                                <div class="input-field">
                                    <label> Mail Adresiniz</label>
                                    <input type="email" name="w3lSender" id="w3lSender" placeholder="" required="">
                                </div>
                                <div class="input-field">
                                    <label> Telefon Numaranız</label>
                                    <input type="text" name="w3lPhone" id="w3lPhone" placeholder="" required="">
                                </div>
                                <div class="input-field">
                                    <label> Konu</label>
                                    <input type="text" name="w3lSubject" id="w3lSubject" placeholder="">
                                </div>
                            </div>
                            <div class="input-field mt-4">
                                <label>Mesajınızı girin</label>
                                <textarea name="w3lMessage" id="w3lMessage" placeholder=""></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary btn-style mt-3">Gönder</button>
                        </form>
                    </div>
                    <div class="col-lg-4 cont-details">
                        <address>
                            <h5 class="">Ofis Adresimiz</h5>
                            <p>
                                <span class="fa fa-map-marker"></span>The blog business centre, 32, My Street,Kingston,
                                New York 12401United States
                            </p>

                            <h5 class="mt-4 pt-lg-3">İletişim Bilgilerimiz</h5>
                            <p>
                                <span class="fa fa-mobile"></span> <strong>Phone :</strong>
                                <a href="tel:+1(12) 366 411 4999"> (+1) 366 411 499</a>
                            </p>

                            <p>
                                <span class="fa fa-phone"></span> <strong>Tel :</strong>
                                <a href="tel:+1(12) 366 411 4999"> (+1) 366 411 499</a>
                            </p>

                            <p>
                                <span class="fa fa-envelope"></span> <strong>Email :</strong>
                                <a href="mailto:mail@example.com"> mail@example.com</a>
                            </p>

                            <h5 class="mt-4 pt-lg-3 mb-3">Bizimle iletişime geçmekten çekinmeyin</h5>
                            <p>
                                We want to provide you with a great experience which is why we want to hear from you.
                                .
                            </p>
                        </address>
                    </div>
                </div>
            </div>
        </div>
        <div class="map mt-5">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d387190.2895687731!2d-74.26055986835598!3d40.697668402590374!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c24fa5d33f083b%3A0xc80b8f06e177fe62!2sNew+York%2C+NY%2C+USA!5e0!3m2!1sen!2sin!4v1562582305883!5m2!1sen!2sin"
                    frameborder="0" style="border:0" allowfullscreen=""></iframe>
        </div>
    </div>
</section>
<!-- //contacts -->
